# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Required for authentication, database services, and client integrations.
# Retrieve these from your Supabase dashboard: Project Settings > API.
# SUPABASE_* variables are used in server-side environments.
# VITE_SUPABASE_* variables are exposed to the browser client by Vite.

SUPABASE_PROJECT_ID="your_supabase_project_id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
SUPABASE_URL="https://your-project-id.supabase.co"

VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# ==============================================================================
# MongoDB Database
# ==============================================================================
# Connection string for your MongoDB database (local instance or MongoDB Atlas cluster).
# Make sure your MongoDB service is running locally or specify a remote Atlas URI.
MONGODB_URI="mongodb://127.0.0.1:27017/your_dev_db"

# ==============================================================================
# Google Maps API Configuration
# ==============================================================================
# Public key used by the browser (Maps JavaScript API + Places API).
# Restrict this key by HTTP referrer in Google Cloud Console (e.g., http://localhost:5173/*).
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_client_api_key_here"

# Server-only key used by backend services to call the Directions & Geocoding APIs
# (trip estimation, geocoding lookups). Restrict this key by server IP address,
# NOT by HTTP referrer, and never expose it to the client.
# Falls back to VITE_GOOGLE_MAPS_API_KEY if left unset.
GOOGLE_MAPS_SERVER_API_KEY="your_google_maps_server_api_key_here"

# ==============================================================================
# Single Admin Account Configuration
# ==============================================================================
# Credentials used to seed/authenticate the administrator account.
# Replace with a strong, secure password for staging and production environments.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your_secure_admin_password_here"
ADMIN_NAME="System Administrator"

# ==============================================================================
# WhatsApp & SMS OTP Authentication (Optional)
# ==============================================================================
# Meta WhatsApp Cloud API (Official 1,000 free customer conversations/month)
# Obtain from https://developers.facebook.com > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Twilio SMS / WhatsApp (Alternative Gateway)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_NUMBER=""
